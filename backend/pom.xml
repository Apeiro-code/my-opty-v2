<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The version is 4.1.1 and not 4.1.1.RELEASE. start.spring.io emits the
        latter, and it does not resolve on Maven Central: the `RELEASE` suffix is
        an Initializr-side label, not a published version. Pinning it here means
        a fresh clone builds on a machine that has never seen the project.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.myopty</groupId>
    <artifactId>myopty-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>myopty-parent</name>
    <description>MyOpty - Flanet Opticals. Reactor parent for the backend modules.</description>

    <modules>
        <!-- Cross-module interfaces and events. No Spring, no entities. -->
        <module>contracts</module>
        <!-- Auth, users, Q&amp;A, config. Owns the V1 migration band. -->
        <module>shared</module>
        <!-- Catalog and inventory. Owns V2-V99. -->
        <module>catalog</module>
        <!-- Order and prescription. Owns V100-V199. -->
        <module>order</module>
        <!-- Workflow and communication. Owns V200-V299. -->
        <module>workflow</module>
        <!-- Payment and billing. Owns V300-V399. -->
        <module>billing</module>
        <!-- The only runnable module. -->
        <module>myopty-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Not managed by the Spring Boot BOM; pinned here so all modules agree. -->
        <springdoc.version>3.1.0</springdoc.version>
        <spotless.version>3.10.3</spotless.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Reactor modules, so a module depends on a sibling by type, not version. -->
            <dependency>
                <groupId>com.myopty</groupId>
                <artifactId>contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.myopty</groupId>
                <artifactId>shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.myopty</groupId>
                <artifactId>catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.myopty</groupId>
                <artifactId>order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.myopty</groupId>
                <artifactId>workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.myopty</groupId>
                <artifactId>billing</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                Skipped here and enabled in myopty-app. Without this, `./mvnw
                spring-boot:run` from backend/ tries to start the reactor itself and
                fails with "Unable to find a suitable main class", and `install`
                repackages every library jar as an executable Spring Boot image. Both
                are wrong: only myopty-app is runnable, and the other six are libraries
                consumed by it.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!--
                The coding standard, enforced by the same command as the tests.
                Palantir's formatter, not Google's, because it indents four spaces
                and wraps at 120 columns — what .editorconfig and every existing
                file already do. `verify` runs `spotless:check`, so a formatting
                violation fails the build; `./mvnw spotless:apply` fixes it.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>