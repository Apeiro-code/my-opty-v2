# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
# Order matters: `.env*` is ignored wholesale, then the example files are taken
# back out. Putting `!.env.example` BEFORE the broad rule does not work, because
# git refuses to re-include a file inside a directory it has already excluded.

.env
.env.*
!.env.example
!.env.*.example

# Credentials that have no business being committed under any name.
*.pem
*.key
*.p12
*.jks
id_rsa
id_ed25519
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# IDE
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.sts4-cache/
.vscode/
nbproject/
nbbuild/

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Logs and scratch output
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/

# ---------------------------------------------------------------------------
# Local database and object-store volumes created by Docker Compose
# ---------------------------------------------------------------------------
# Named volumes live outside the working tree, but bind-mounted dumps do not.
*.sql.gz
*.dump
docker-data/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# R
.Rhistory
.RData
.Rproj.user/

# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
junit.xml
