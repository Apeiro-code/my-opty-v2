# ---------------------------------------------------------------------------
# MyOpty local environment contract
#
# This file is the single list of configuration the project reads. It is
# committed; the file you fill in is not.
#
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) and must never be committed. If a real
# credential reaches a commit it has to be rotated, so treat that as a bug rather
# than an annoyance -- `scripts/check-env.sh` fails if `.env` is ever tracked.
#
# Rules for changing this file:
#   1. Every variable the application reads must appear here, with a default that
#      works on a fresh clone.
#   2. Secrets are shipped EMPTY with a generation command in the comment. Do not
#      commit a working password "just for dev" -- that value gets copied to
#      staging by someone in a hurry, and then it is a leaked credential.
#   3. Changing a variable name is a breaking change for the other three
#      developers' `.env` files. Say so in the PR description.
#
# Nothing here is read by the frontend except the two NEXT_PUBLIC_ variables, and
# those are inlined into the browser bundle at build time -- never put a secret
# behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------


# == Database ================================================================
# MySQL 8.0, run by Docker Compose. The port is 3307, not 3306, because a
# native MySQL often already owns 3306 on developer machines and a port clash
# makes the whole stack fail to start for a reason that looks unrelated.

DB_URL=jdbc:mysql://localhost:3307/myopty?createDatabaseIfNotExist=true
DB_NAME=myopty

# The application's own account. It owns `myopty` and nothing else, so a
# compromised application cannot reach other schemas on the server.
DB_USERNAME=myopty
DB_PASSWORD=

# Root on the MySQL container. Used only by Docker Compose to initialise the
# volume; the application never authenticates as root.
DB_ROOT_PASSWORD=

# Flyway is the only thing that may write DDL. Leave enabled: the schema is
# built from migrations on startup, which is how every developer and CI get the
# same tables.
DB_FLYWAY_ENABLED=true


# == Authentication =========================================================
# Signs the JWTs that stand in for a session. An empty or short value is a hard
# startup failure on purpose: a predictable signing key means anyone can mint a
# token for any customer. Generate one with:
#
#     openssl rand -base64 48
#
JWT_SECRET=

# How long an access token stays valid. ISO-8601 duration.
JWT_ACCESS_TOKEN_TTL=PT1H
JWT_ISSUER=myopty


# == Email ==================================================================
# Locally, Docker Compose runs Mailpit: it speaks SMTP on 1025 and shows every
# message it receives at http://localhost:8025. Nothing leaves your machine and
# no account is needed.
#
# For staging and production, point these at the real provider and set
# MAIL_USERNAME / MAIL_PASSWORD to its credentials.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@myopty.local

# Fail loudly when mail cannot be sent. `false` logs and moves on, which is what
# you want while developing a feature and what you do NOT want in staging: a
# customer who is never told their order is ready finds out at the counter.
MAIL_FAIL_ON_ERROR=false


# == Object storage (prescription uploads) ==================================
# Prescription scans and photos are objects, not rows: the bytes go here and
# `prescription` keeps only the metadata. Runs in Docker Compose alongside MySQL.
# Generate the keys with:
#
#     openssl rand -hex 24
#
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=myopty
MINIO_SECRET_KEY=
MINIO_BUCKET=prescription-documents


# == Payment gateway ========================================================
# `fake` is a local stand-in that authorizes, captures and refunds in memory so
# the billing module can be built and tested without a merchant account. It moves
# no money and must never be the configured provider outside a developer's
# machine. Set PAYMENT_GATEWAY_PROVIDER to the real provider once the sandbox
# credentials from docs/DEPLOYMENT.md are in hand.
PAYMENT_GATEWAY_PROVIDER=fake
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_API_VERSION=


# == Web ====================================================================
# Where the Next.js app reaches the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Browsers the API accepts requests from. The Next.js dev server origin belongs
# here; every origin is a place a logged-out visitor's browser can send requests
# from, so this is a list, not a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Log out end users. Use `info` locally so the request/response bodies needed to
# debug a story are visible, `warn` in staging, `error` in production.
LOG_LEVEL=info

# The one URL the staging preview serves on (backend/compose.prod.yaml binds it
# to loopback). 8088 rather than 80 or 3000 so a preview can run alongside the
# dev servers instead of competing with them for a port.
PREVIEW_PORT=8088
